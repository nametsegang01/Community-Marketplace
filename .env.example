# Copy the Project URL from your Supabase project's API settings.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Use the publishable key from the same project. Never use a secret/service_role key here.
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Required for sign-up confirmation links; use your deployed Render URL, never localhost.
VITE_APP_URL=https://your-service-name.onrender.com
