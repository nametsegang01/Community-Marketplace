rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profileExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function profile(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function activeCustomer() {
      return signedIn() &&
        profileExists(request.auth.uid) &&
        profile(request.auth.uid).role == 'customer' &&
        profile(request.auth.uid).accountStatus == 'active';
    }

    function approvedSeller() {
      return signedIn() &&
        profileExists(request.auth.uid) &&
        profile(request.auth.uid).role == 'seller' &&
        profile(request.auth.uid).accountStatus == 'active' &&
        profile(request.auth.uid).sellerStatus == 'approved';
    }

    function isAdmin() {
      return signedIn() &&
        profileExists(request.auth.uid) &&
        profile(request.auth.uid).role == 'admin' &&
        profile(request.auth.uid).accountStatus == 'active';
    }

    function validNewProfile(uid) {
      return signedIn() &&
        request.auth.uid == uid &&
        request.resource.data.uid == uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.role in ['customer', 'seller'] &&
        request.resource.data.accountStatus ==
          (request.resource.data.role == 'seller' ? 'pending' : 'active') &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp &&
        request.resource.data.termsAcceptedAt is timestamp &&
        request.resource.data.firstName is string &&
        request.resource.data.lastName is string &&
        request.resource.data.phoneNumber is string &&
        request.resource.data.keys().hasOnly([
          'uid', 'firstName', 'lastName', 'email', 'phoneNumber', 'role',
          'accountStatus', 'createdAt', 'updatedAt', 'termsAcceptedAt',
          'shopName', 'businessDescription', 'village', 'sellerStatus'
        ]) &&
        (
          request.resource.data.role == 'customer' ||
          (
            request.resource.data.shopName is string &&
            request.resource.data.businessDescription is string &&
            request.resource.data.village is string &&
            request.resource.data.sellerStatus == 'pending'
          )
        ) &&
        (
          request.resource.data.role == 'seller' ||
          !request.resource.data.keys().hasAny([
            'shopName', 'businessDescription', 'village', 'sellerStatus'
          ])
        );
    }

    function stockIsForOrder(productId) {
      let order = getAfter(
        /databases/$(database)/documents/orders/$(request.resource.data.stockOrderId)
      ).data;
      let quantity = resource.data.stock - request.resource.data.stock;
      return request.resource.data.stockOrderId is string &&
        request.resource.data.stock is int &&
        resource.data.stock is int &&
        quantity > 0 &&
        order.buyerId == request.auth.uid &&
        order.sellerId == resource.data.sellerId &&
        order.status == 'Order placed' &&
        order.productLines.hasAny([
          { 'productId': productId, 'quantity': quantity }
        ]);
    }

    match /users/{uid} {
      allow create: if validNewProfile(uid);
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow update: if isAdmin() ||
        (
          signedIn() &&
          request.auth.uid == uid &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.email == resource.data.email &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.accountStatus == resource.data.accountStatus &&
          request.resource.data.get('sellerStatus', '') == resource.data.get('sellerStatus', '') &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['firstName', 'lastName', 'phoneNumber', 'updatedAt'])
        );
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() ||
        (
          approvedSeller() &&
          request.resource.data.sellerId == request.auth.uid &&
          request.resource.data.stock is int &&
          request.resource.data.stock >= 0
        );
      allow update: if isAdmin() ||
        (
          approvedSeller() &&
          resource.data.sellerId == request.auth.uid &&
          request.resource.data.sellerId == resource.data.sellerId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'detail', 'place', 'price', 'stock', 'unit', 'category', 'image', 'seller', 'stockOrderId'])
        ) ||
        (
          activeCustomer() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['stock', 'stockOrderId']) &&
          request.resource.data.stock < resource.data.stock &&
          stockIsForOrder(productId)
        );
      allow delete: if isAdmin() ||
        (approvedSeller() && resource.data.sellerId == request.auth.uid);
    }

    match /sellers/{sellerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if activeCustomer() &&
        request.resource.data.buyerId == request.auth.uid &&
        request.resource.data.status == 'Order placed' &&
        request.resource.data.paid == false &&
        !request.resource.data.keys().hasAny(['buyerReceived', 'buyerPaid']) &&
        request.resource.data.productLines is list &&
        request.resource.data.productLines.size() > 0;
      allow get, list: if isAdmin() ||
        (signedIn() && resource.data.buyerId == request.auth.uid) ||
        (approvedSeller() && resource.data.sellerId == request.auth.uid);
      allow update: if isAdmin() ||
        (
          signedIn() &&
          resource.data.buyerId == request.auth.uid &&
          resource.data.status in ['Ready for pickup', 'Out for delivery'] &&
          request.resource.data.buyerId == resource.data.buyerId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['buyerReceived', 'buyerPaid']) &&
          request.resource.data.buyerReceived == true &&
          request.resource.data.buyerPaid is bool
        ) ||
        (
          approvedSeller() &&
          resource.data.sellerId == request.auth.uid &&
          request.resource.data.sellerId == resource.data.sellerId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['paid', 'status']) &&
          (
            request.resource.data.status == resource.data.status ||
            request.resource.data.status in [
              'Seller confirmed', 'Ready for pickup', 'Out for delivery', 'Completed'
            ]
          ) &&
          (
            request.resource.data.status != 'Completed' ||
            (
              request.resource.data.paid == true &&
              resource.data.buyerReceived == true &&
              resource.data.buyerPaid == true
            )
          )
        );
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
